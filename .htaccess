RewriteEngine On

# Admin assets (JS/CSS/images/pages from AJAX context)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin/assets/(.*)$ assets/$1 [L,QSA]

# Dashboard assets/pages from AJAX context
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^dashboard/assets/(.*)$ assets/$1 [L,QSA]

# Dashboard API calls from nested context
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^dashboard/([a-z_][a-z0-9_]*\.php)$ $1 [L,QSA]

# Non-existent PHP files under admin/ → root (e.g. admin/avatar.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^admin/([a-z_][a-z0-9_]*\.php)$ $1 [L,QSA]

# Short admin URLs: /admin/settings → admin/index.php?page=settings
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/([a-z][a-z0-9_-]*)$ admin/index.php?page=$1 [L,QSA]

# Legacy PHP pages without extension: /login → login.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-z_][a-z0-9_-]*)$ $1.php [L,QSA]

# Short URLs: /settings → dashboard/index.php?page=settings
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z][a-z0-9_-]*)$ dashboard/index.php?page=$1 [NC,L,QSA]

# Short dashboard URLs: /dashboard/operations → dashboard/index.php?page=operations
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^dashboard/([a-z][a-z0-9_-]*)$ dashboard/index.php?page=$1 [NC,L,QSA]

# /dashboard → dashboard/index.php
RewriteRule ^dashboard/?$ dashboard/index.php [L,QSA]

# /admin → admin/index.php
RewriteRule ^admin/?$ admin/index.php [L,QSA]
